pkgname=daobuds
pkgver=0.1.0
pkgrel=1
pkgdesc='Native controller for Redmagic Cyberbuds DAO TWS (BH4010) and QCC3086 USB dongle'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'bluez-utils')
makedepends=('gcc' 'make' 'bluez-libs')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/daobuds "$pkgdir/usr/bin/daobuds"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/daobuds.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/daobuds.svg"
  install -Dm644 "$startdir/daobuds.desktop" "$pkgdir/usr/share/applications/daobuds.desktop"
}
